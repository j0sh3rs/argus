{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "argus",
  "type": "object",
  "properties": {
    "forwarder": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" },
            "pullPolicy": { "type": "string" }
          },
          "required": ["repository", "tag", "pullPolicy"]
        },
        "holmesUrl": { "type": "string" },
        "holmesModel": { "type": "string" },
        "holmesTimeoutSec": { "type": "integer", "minimum": 10 },
        "investigateSeverities": { "type": "string" },
        "dedupeTtlSec": { "type": "integer", "minimum": 0 },
        "logLevel": {
          "type": "string",
          "enum": ["DEBUG", "INFO", "WARNING", "ERROR"]
        },
        "serviceAccount": {
          "type": "object",
          "properties": {
            "create": { "type": "boolean" },
            "name": { "type": "string" }
          }
        },
        "resources": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" },
        "discordSecret": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "key": { "type": "string" }
          },
          "required": ["name", "key"]
        }
      },
      "required": ["image", "holmesUrl", "holmesModel", "discordSecret"]
    },
    "holmes": { "type": "object" }
  },
  "required": ["forwarder"]
}
